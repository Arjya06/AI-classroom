# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API Base URL
# In AI Studio preview, leave as /api (proxied by Express/Vite).
# When running locally against Spring Boot, set to http://localhost:8080/api
VITE_API_BASE_URL="/api"
